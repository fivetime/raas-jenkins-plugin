<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
  <f:entry title="${%Name}" field="name">
    <f:textbox clazz="required" default="raas"/>
  </f:entry>
  <f:entry title="${%RaaS URL}" field="url">
    <f:textbox default="https://raas.tue.jp"/>
  </f:entry>
  <f:entry title="${%Application credential}" field="credentialsId">
    <c:select/>
  </f:entry>
  <f:entry title="${%Connect timeout (minutes)}" field="connectTimeoutMinutes">
    <f:number min="1" max="120" default="15"/>
  </f:entry>
  <f:validateButton title="${%Test connection}" progress="${%Asking RaaS which labels you can use…}"
                    method="testConnection" with="url,credentialsId"/>
</j:jelly>
